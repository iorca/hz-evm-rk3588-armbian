/*
 * HZ-EVM-RK3588 (合众恒跃) U-Boot device tree
 *
 * This is the *U-Boot* device tree only, and must stay minimal: mainline
 * U-Boot ships a trimmed rk3588.dtsi (via dts/upstream) that does NOT
 * contain most kernel-only nodes (vop/gpu/tsadc/hdmi_receiver/...).
 * Anything referenced here must exist in the U-Boot tree.
 *
 * The full Linux kernel device tree lives separately in
 * patch/kernel/rk35xx-current/dt/rk3588-hz-evm-rk3588.dts
 */

/dts-v1/;

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/pinctrl/rockchip.h>
#include "rk3588.dtsi"

/ {
	model = "HZ-EVM-RK3588";
	compatible = "hezuo,hz-evm-rk3588", "rockchip,rk3588";

	aliases {
		mmc0 = &sdmmc;
		mmc1 = &sdhci;
	};

	chosen {
		stdout-path = "serial2:1500000n8";
	};

	/* 5V main rail, always on */
	vcc5v0_sys: vcc5v0-sys {
		compatible = "regulator-fixed";
		regulator-name = "vcc5v0_sys";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
	};

	vcc3v3_sys: vcc3v3-sys {
		compatible = "regulator-fixed";
		regulator-name = "vcc3v3_sys";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		vin-supply = <&vcc5v0_sys>;
	};

	vcc_3v3_sd_s0: vcc-3v3-sd-s0 {
		compatible = "regulator-fixed";
		regulator-name = "vcc_3v3_sd_s0";
		regulator-boot-on;
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		vin-supply = <&vcc3v3_sys>;
	};
};

/* --- eMMC: boot device, bootph markers added in the -u-boot.dtsi --- */
&sdhci {
	bus-width = <8>;
	no-sdio;
	no-sd;
	non-removable;
	max-frequency = <200000000>;
	status = "okay";
};

/* --- SD card: primary recovery boot device --- */
&sdmmc {
	bus-width = <4>;
	cap-sd-highspeed;
	disable-wp;
	no-mmc;
	no-sdio;
	vmmc-supply = <&vcc_3v3_sd_s0>;
	status = "okay";
};

/* --- Debug UART2 (1500000n8) --- */
&uart2 {
	pinctrl-names = "default";
	pinctrl-0 = <&uart2m0_xfer>;
	status = "okay";
};

/*
 * NOTE: GMAC is intentionally left out of the U-Boot device tree.
 * Mainline U-Boot's trimmed rk3588 dtsi does not guarantee the gmac0
 * pinmux labels, and the board boots from SD/eMMC, so U-Boot networking
 * is not needed for bring-up. Add it later if TFTP boot is required.
 */

/* --- USB --- */
&u2phy0 {
	status = "okay";
};

&u2phy0_otg {
	status = "okay";
};

&u2phy2 {
	status = "okay";
};

&u2phy2_host {
	status = "okay";
};

&u2phy3 {
	status = "okay";
};

&u2phy3_host {
	status = "okay";
};

&usb_host0_ehci {
	status = "okay";
};

&usb_host0_ohci {
	status = "okay";
};

&usb_host0_xhci {
	status = "okay";
};

&usb_host1_ehci {
	status = "okay";
};

&usb_host1_ohci {
	status = "okay";
};

&usb_host1_xhci {
	status = "okay";
};

/* --- PCIe 3.0 x4 slot --- */
&pcie3x4 {
	reset-gpios = <&gpio4 RK_PB6 GPIO_ACTIVE_HIGH>;
	vpcie3v3-supply = <&vcc3v3_sys>;
	status = "okay";
};

&combphy2_psu {
	status = "okay";
};
